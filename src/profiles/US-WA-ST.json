{
  "schemaVersion": 1,
  "id": "us-wa-st",
  "name": "Sound Transit mapping profile",
  "version": "1.0.0",
  "sourceFeeds": [
    {
      "id": "US-WA-ST",
      "displayName": "Sound Transit",
      "enabled": true,
      "geometryTarget": "osm",
      "streetNameCleanup": true,
      "additionalTags": [
        {
          "key": "public_transport",
          "value": { "kind": "constant", "value": "platform" },
          "appliesTo": { "locationKinds": ["platform"] }
        },
        {
          "key": "highway",
          "value": { "kind": "constant", "value": "bus_stop" },
          "appliesTo": { "locationKinds": ["platform"] }
        }
      ],
      "removeKeys": ["gtfs:stop_id", "gtfs:stop_id:US-WA-ST", "gtfs:feed"]
    }
  ],
  "mappingRules": [
    {
      "key": "name",
      "value": { "kind": "field", "field": "stop_name_expanded" }
    },
    {
      "key": "gtfs:stop_code:US-WA-ST",
      "value": { "kind": "field", "field": "stop_code" },
      "appliesTo": { "sourceFeedIds": ["US-WA-ST"] }
    }
  ],
  "candidateRadiusMeters": 50,
  "autoIdRadiusMeters": 10
}
