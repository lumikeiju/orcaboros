{
  "name": "orcaboros",
  "version": "0.2.0",
  "description": "A browser-first, safety-focused GTFS stop to OpenStreetMap node review tool.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Lumikeiju",
  "repository": {
    "type": "git",
    "url": "https://github.com/lumikeiju/orcaboros.git"
  },
  "bugs": {
    "url": "https://github.com/lumikeiju/orcaboros/issues"
  },
  "homepage": "https://github.com/lumikeiju/orcaboros",
  "keywords": [
    "gtfs",
    "openstreetmap",
    "conflation",
    "transit"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "bun run format:check && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "fflate": "^0.8.3",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
