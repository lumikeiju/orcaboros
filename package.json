{
  "name": "orcaboros",
  "version": "1.0.0",
  "description": "In-browser GTFS-to-OSM conflation tool.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Lumikeiju",
  "repository": {
    "type": "git",
    "url": "https://github.com/lumikeiju/orcaboros.git"
  },
  "bugs": {
    "url": "https://github.com/lumikeiju/orcaboros/issues"
  },
  "homepage": "https://github.com/lumikeiju/orcaboros",
  "keywords": [
    "gtfs",
    "openstreetmap",
    "conflation",
    "transit"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "bun run format:check && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "fflate": "^0.8.3",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
